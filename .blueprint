    - database/factories/DataRegistrasiFactory.php
    - database/factories/PendudukFactory.php
    - database/factories/KategoriFactory.php
    - database/factories/LayananFactory.php
    - database/factories/PermohonanFactory.php
    - database/factories/SyaratLayananFactory.php
    - database/factories/DataPermohonanFactory.php
    - database/factories/AutoReplyFactory.php
    - database/migrations/2025_11_22_071400_create_rws_table.php
    - database/migrations/2025_11_22_071401_create_rts_table.php
    - database/migrations/2025_11_22_071402_create_registrasis_table.php
    - database/migrations/2025_11_22_071403_create_data_registrasis_table.php
    - database/migrations/2025_11_22_071404_create_penduduks_table.php
    - database/migrations/2025_11_22_071405_create_kategoris_table.php
    - database/migrations/2025_11_22_071406_create_layanans_table.php
    - database/migrations/2025_11_22_071407_create_permohonans_table.php
    - database/migrations/2025_11_22_071408_create_syarat_layanans_table.php
